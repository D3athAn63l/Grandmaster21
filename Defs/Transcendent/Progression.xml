<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ResearchProjectDef>
    <defName>GM21_MythicalCraftsmanship</defName>
    <label>mythical craftsmanship</label>
    <description>Unlock Mythical craftsmanship, its workstation and catalyst manufacture. All projects require a Crafting Grandmaster. Lower-tier and ordinary Legendary outcomes remain possible.</description>
    <baseCost>8000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>GM21_MagicalCraftsmanship</li>
    </prerequisites>
    <researchViewX>16</researchViewX>
    <researchViewY>6</researchViewY>
  </ResearchProjectDef>
  <ThingDef>
    <defName>GM21_MythicalWorkstation</defName>
    <label>mythical workstation</label>
    <description>A Mythical ceiling workstation. A Crafting Grandmaster commits recipe ingredients and one mythical matrix permanently. Work may be resumed by another Crafting Grandmaster. Destroying this workstation loses its project; committed projects cannot be cancelled, refunded or moved.</description>
    <thingClass>Grandmaster21.Transcendent.Building_MagicalWorkstation</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Never</tickerType>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <graphicData>
      <texPath>Things/Building/Production/TableMachining</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
    </graphicData>
    <size>(3,1)</size>
    <rotatable>true</rotatable>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <designationCategory>Production</designationCategory>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>GM21_MythicalCraftsmanship</li>
    </researchPrerequisites>
    <costList>
      <Steel>400</Steel>
      <Plasteel>200</Plasteel>
      <ComponentSpacer>20</ComponentSpacer>
    </costList>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>20000</WorkToBuild>
      <Mass>50</Mass>
      <Flammability>0.2</Flammability>
      <WorkTableWorkSpeedFactor>1</WorkTableWorkSpeedFactor>
      <WorkTableEfficiencyFactor>1</WorkTableEfficiencyFactor>
    </statBases>
    <building>
      <isEdifice>true</isEdifice>
    </building>
  </ThingDef>
  <ThingDef>
    <defName>GM21_MythicalMatrix</defName>
    <label>mythical matrix</label>
    <description>Manufactured at a fabrication bench for Mythical projects. Consumed at commitment. This catalyst is not Stuff and does not replace the equipment material.</description>
    <thingClass>Verse.ThingWithComps</thingClass>
    <category>Item</category>
    <altitudeLayer>Item</altitudeLayer>
    <drawerType>MapMeshOnly</drawerType>
    <tickerType>Never</tickerType>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <graphicData>
      <texPath>Things/Item/Resource/ComponentSpacer</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <stackLimit>10</stackLimit>
    <tradeability>None</tradeability>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.2</Mass>
      <MarketValue>8000</MarketValue>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>
