  <RecipeDef>
    <defName>GM21_MakeMagicalCatalyst</defName>
    <label>make magical catalyst</label>
    <description>Manufacture one catalyst for Magical craftsmanship.</description>
    <jobString>Manufacturing a catalyst.</jobString>
    <workAmount>18000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <skillRequirements>
      <Crafting>12</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>FabricationBench</li>
    </recipeUsers>
    <researchPrerequisite>GM21_MagicalCraftsmanship</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Plasteel</li>
        <li>Gold</li>
        <li>ComponentSpacer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <GM21_MagicalCatalyst>1</GM21_MagicalCatalyst>
    </products>
  </RecipeDef>
